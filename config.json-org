{
  "inbounds": [
    {
      "tag": "<< ServerName or IP >>",
      "type": "vless",
      "listen": "::",
      "listen_port": 51030,
      "users": [
        {
          "flow": "xtls-rprx-vision",
          "uuid": "<< UUID >>"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "<< SNI >>",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "<< SNI >>",
            "server_port": 443
          },
          "private_key": "<< Private_Key >>",
          "short_id": [
            "<< Short ID >>"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct"
    },
    {
      "tag": "public-key:<< Public_Key >>",
      "type": "block"
    }
  ]
}
